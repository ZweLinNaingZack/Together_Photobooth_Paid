# Cloudflare Realtime TURN key. Keep these server-only (no VITE_ prefix).
# Copy this file to .env, fill in the values locally, then restart the preview.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# Browser-safe Supabase settings. Never use a secret/service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel backend only. NEVER prefix the service-role key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public Turnstile widget key; put its SECRET in Supabase Auth CAPTCHA settings.
VITE_TURNSTILE_SITE_KEY=
# Keep false until Resend SMTP/domain and email templates are ready.
VITE_AUTH_EMAIL_FLOWS_ENABLED=false

# Payment email worker: server-only settings (never add VITE_).
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=zwelinnaing34@gmail.com
SUPPORT_EMAIL=
SITE_URL=
EMAIL_WORKER_SECRET=
# Optional HTTPS logo URL; defaults to SITE_URL/email-logo.png.
EMAIL_LOGO_URL=
